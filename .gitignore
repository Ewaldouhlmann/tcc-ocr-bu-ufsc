# Corpus: os PDFs e as imagens das obras pertencem ao acervo do NUPILL e não são
# versionados. A regra ouro (data/corpus/regra_ouro/) e os resultados do
# benchmark (data/results/) são versionados, para que a avaliação possa ser
# reproduzida sem rodar os modelos de novo.
data/corpus/pdfs/
data/corpus/images/
data/results/extracao/extracao.log

# Saídas avulsas do pipeline
output/
input/

# LaTeX: arquivos auxiliares da compilação (o main.pdf é versionado)
escrita tcc/*.aux
escrita tcc/*.bbl
escrita tcc/*.blg
escrita tcc/*.fdb_latexmk
escrita tcc/*.fls
escrita tcc/*.lof
escrita tcc/*.lot
escrita tcc/*.toc
escrita tcc/*.log
escrita tcc/*.out
escrita tcc/*.synctex.gz

# Pacotes para envio (Overleaf, downloads); são regenerados quando preciso
*.zip

# Planilhas pessoais de acompanhamento do TCC
docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp

# Chaves de API (usar .env.example como modelo)
.env

# Estado transitório da extração (página em processamento)
data/results/extracao/_estado/*.atual
